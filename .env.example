# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.
# The `development` network does NOT need any of these.

# 12/24-word seed phrase of a THROWAWAY testnet wallet (no real funds, ever).
# Left as a placeholder on purpose: well-known public mnemonics ("test test ... junk") are swept
# by bots on public chains, and an invalid placeholder makes the deploy fail loudly instead.
MNEMONIC="replace with the twelve words of your own throwaway testnet wallet"

# Sepolia JSON-RPC endpoint (Infura, Alchemy, or any public RPC).
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_PROJECT_ID"
